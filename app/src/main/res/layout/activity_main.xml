<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:spacing="8dp">

        <Button
            android:id="@+id/btnOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Concedi Permesso Overlay" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Palette Colori:"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerPalette"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvAlpha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trasparenza: 100%" />
        <SeekBar
            android:id="@+id/sbAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:max="100" />

        <TextView
            android:id="@+id/tvThickness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spessore linea: 1 dp" />
        <SeekBar
            android:id="@+id/sbThickness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:max="50" />

        <TextView
            android:id="@+id/tvPadding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Distanza dai bordi: 0 dp" />
        <SeekBar
            android:id="@+id/sbPadding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:max="100" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mostra Barra Superiore (Status Bar)" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchLeftBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mostra Barra Sinistra" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchRightBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mostra Barra Destra" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#444" android:layout_marginVertical="8dp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAnimation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Animazione Ricarica" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchWave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Effetto Liquido" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPulse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pulsazione Batteria Scarica" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchHideFull"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nascondi a carica completa" />

        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Avvia Sovraimpressione" />
    </LinearLayout>
</ScrollView>
