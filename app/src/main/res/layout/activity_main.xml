<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Battery Glass Setup"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Concedi Permesso Overlay" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Palette Colori:"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerPalette"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvThickness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Spessore linea: 12 dp" />

        <SeekBar
            android:id="@+id/sbThickness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40"
            android:progress="12" />

        <TextView
            android:id="@+id/tvPadding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Distanza dai bordi (Bordi curvi): 0 dp" />

        <SeekBar
            android:id="@+id/sbPadding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:progress="0" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAnimation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="Animazione Ricarica" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchWave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Effetto Onda Liquida" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPulse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Pulsazione Batteria Scarica (&lt;=15%)" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchHideFull"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="Nascondi a carica completa (100%)" />

        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Avvia Sovraimpressione" />

    </LinearLayout>
</ScrollView>
